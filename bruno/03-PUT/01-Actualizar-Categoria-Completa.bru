meta {
  name: 01. Actualizar Categoría Completa (PUT /api/categorias/:id)
  type: http
  seq: 1
}

put {
  url: {{baseUrl}}/api/categorias/{{categoria_id}}
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{token}}
  Content-Type: application/json
}

body:json {
  {
    "nombre": "Farmacia Veterinaria y Medicinas"
  }
}

tests {
  test("Status HTTP debe ser 200", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("Nombre de la categoría fue actualizado completamente", function() {
    expect(res.getBody().nombre).to.equal('Farmacia Veterinaria y Medicinas');
  });
}

