meta {
  name: 06. Obtener Cliente por ID (GET /api/clientes/:id)
  type: http
  seq: 6
}

get {
  url: {{baseUrl}}/api/clientes/1
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{token}}
}

tests {
  test("Status HTTP debe ser 200", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("Retorna datos del cliente con ID 1", function() {
    expect(res.getBody().id).to.equal(1);
    expect(res.getBody().nombre).to.be.a('string');
  });
}

