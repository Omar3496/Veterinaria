meta {
  name: 08. Obtener Cita por ID (GET /api/citas/:id)
  type: http
  seq: 8
}

get {
  url: {{baseUrl}}/api/citas/1
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{token}}
}

tests {
  test("Status HTTP debe ser 200", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("Retorna datos de la cita con ID 1", function() {
    expect(res.getBody().id).to.equal(1);
    expect(res.getBody().estado).to.be.a('string');
  });
}

