meta {
  name: 10. Obtener Categoría por ID (GET /api/categorias/:id)
  type: http
  seq: 10
}

get {
  url: {{baseUrl}}/api/categorias/1
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{token}}
}

tests {
  test("Status HTTP debe ser 200", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("Retorna datos de la categoría con ID 1", function() {
    expect(res.getBody().id).to.equal(1);
    expect(res.getBody().nombre).to.be.a('string');
  });
}

