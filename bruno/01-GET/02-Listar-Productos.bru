meta {
  name: 02. Listar Productos Públicos (GET /api/productos)
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/productos?skip=0&limit=10
  body: json
  auth: none
}

tests {
  test("Status HTTP debe ser 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
  
  test("Retorna arreglo de productos del catálogo", function() {
    expect(res.getBody()).to.be.an('array');
  });
}
