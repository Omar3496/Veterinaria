meta {
  name: 03. Login Personalizado (POST /token)
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/token
  body: formUrlEncoded
  auth: none
}

body:form-urlencoded {
  username: {{?Username (ej. admin, vet, recep, jperez)}}
  password: {{?Password (ej. admin123, vet123, recep123, cliente123)}}
}

vars:post-response {
  token: res.body.access_token
  rol_activo: res.body.user.rol
  username_activo: res.body.user.username
}

script:post-response {
  if (res.body && res.body.access_token) {
    bru.setVar("token", res.body.access_token);
    bru.setEnvVar("token", res.body.access_token);
  }
}

tests {
  test("Status HTTP debe ser 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
  
  test("Debe retornar token JWT", function() {
    expect(res.getBody().access_token).to.be.a('string');
  });
  
  test("Retorna información del usuario autenticado", function() {
    expect(res.getBody().user).to.be.an('object');
  });
}
